# Copy this file to .env and fill in real values. Never commit .env.

# For local development, set DEBUG=True
# For Vercel production, set DEBUG=False in Vercel environment variables
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-string

# For local development: localhost,127.0.0.1
# For Vercel production: .vercel.app,your-custom-domain.com (set in Vercel env vars)
ALLOWED_HOSTS=localhost,127.0.0.1

# Required in Vercel production. Leave unset locally to use SQLite.
DATABASE_URL=

# Deriv API — free app_id works for public market data (candles/ticks).
# Register your own at https://api.deriv.com if you hit rate limits.
DERIV_APP_ID=1089
# DERIV_API_TOKEN=your_api_token_here # Optional: Leave empty for public access
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=33h7WTrgcf2hU3wKvR4fk

# Paper trading only — no live orders are ever placed by this project.
PAPER_STARTING_BALANCE=10

# Email alerts (Gmail example — use an App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-alert-sender@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
ALERT_CONTACT_EMAIL=your-personal@gmail.com
ALERT_COOLDOWN_MINUTES=240

# How often (seconds) the analysis loop re-scans each market
ANALYSIS_INTERVAL_SECONDS=30
# How often (hours) models retrain on fresh candles
MODEL_RETRAIN_HOURS=6

# AI chart assistant (floating brain icon + AI Chart page) — get a key at
# https://console.anthropic.com. Leave blank to disable the chat panel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Groq API for AI chat — get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Finnhub API for market news — get a key at https://finnhub.io
FINNHUB_API_KEY=

# Google OAuth for login/signup — create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SITE_DOMAIN=localhost:8000
